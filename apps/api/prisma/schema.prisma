// UESTC TeamUp 数据模型
// 依据 docs/字段清单.md 落地。
// 2026-09-19「广告牌模式」改版：
// - 平台不做申请/邀请/审批/私聊，不跟踪成员与名额，移除 TeamMember / TeamSlot /
//   Application / Invitation / Workspace / Review 及 SlotStatus / ApplicationStatus 枚举
// - Team 即「招募帖」，联系方式直接公开；评论区 = Comment(targetType=TEAM) + CommentLike
// - TeamStatus 精简为四态：RECRUITING / FULL 由队长切换，COMPETING 由系统按比赛时间设置，
//   DISBANDED 由队长设置并进入归档仓库

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= 枚举 =================

enum Level {
  INTERNATIONAL
  NATIONAL
  PROVINCIAL
  SCHOOL
}

enum UserRole {
  STUDENT
  CONTRIBUTOR
  ADMIN
}

enum CompetitionFormat {
  INDIVIDUAL
  TEAM
}

enum Audience {
  UNDERGRAD
  POSTGRAD
  MIXED
}

enum TeamGoal {
  PRIZE
  PRACTICE
  NATIONAL_FIRST
  BONUS_ONLY
}

// 招募帖状态：RECRUITING / FULL / DISBANDED 队长手动切换，
// COMPETING 由系统根据竞赛时间线自动设置（比赛开始后不再自动回退）。
enum TeamStatus {
  RECRUITING
  FULL
  COMPETING
  DISBANDED
}

enum RoleType {
  ALGORITHM
  FRONTEND
  BACKEND
  HARDWARE
  MODELING
  UI
  PAPER
  DEFENSE
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SourceHealth {
  HEALTHY
  DEGRADED
  FAILING
  SUSPENDED
}

enum MaterialKind {
  PAST_PAPER
  OPEN_SOURCE
  EXPERIENCE
  TEMPLATE
}

enum CommentTarget {
  COMPETITION
  POST
  TEAM
}

enum NotificationKind {
  DDL_REMINDER
  COMMENT_REPLY
  CRAWL_ANOMALY
  SOURCE_FAILING
  CORRECTION_NEW
  SYSTEM_NOTIFICATION
}

enum RevisionOrigin {
  CRAWL
  MANUAL
  ROLLBACK
}

enum CorrectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SourceKind {
  ACADEMIC_AFFAIRS
  COLLEGE
  COMPETITION_SITE
  ACADEMY_LIST
}

enum ParseStrategy {
  CSS
  JSON_API
  REGEX
}

// ================= 用户 =================

model User {
  id        String   @id @default(cuid())
  studentNo String   @unique
  email     String   @unique
  // 密码（scrypt 哈希）。数据库层保留可空以兼容历史行，注册/完善资料流程中必填
  passwordHash String?
  college   String?
  grade     Int?
  major     String?
  nickname  String?
  bio       String?  @db.Text
  role      UserRole @default(STUDENT)
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills        UserSkill[]
  teamsLed      Team[]            @relation("TeamLeader")
  comments      Comment[]
  commentLikes  CommentLike[]
  favorites     Favorite[]
  notifications Notification[]
  corrections   CorrectionReport[]
  posts         Post[]
  materials     CompetitionMaterial[]
  bans          BanRecord[]       @relation("BannedUser")
  banActions    BanRecord[]       @relation("BanActor")

  @@index([role])
}

model UserSkill {
  userId String
  skill  String
  level  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
}

// ================= 竞赛雷达 =================

model Competition {
  id          String  @id @default(cuid())
  // M2：竞赛名唯一（同名竞赛会造成雷达列表重复、纠错/收藏指向歧义）
  name        String  @unique
  aliases     String[]
  organizer   String?
  officialUrl String?

  format      CompetitionFormat?
  teamSizeMin Int?
  teamSizeMax Int?
  audience    Audience?
  intro       String?  @db.Text

  difficulty Int?
  effort     Int?

  // 推免加分（独立可选字段，人工维护，爬虫无法获得）
  isBonusEligible Boolean?
  bonusCategory   String?
  bonusPoints     String?

  sourceUrl    String?
  lastSyncedAt DateTime?
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  levels        CompetitionLevel[]
  timelines     CompetitionTimeline[]
  tags          CompetitionTag[]
  awards        CompetitionAward[]
  materials     CompetitionMaterial[]
  revisions     CrawlRevision[]
  anomalies     CrawlAnomaly[]
  corrections   CorrectionReport[]
  teams         Team[]

  @@index([status])
  @@index([updatedAt])
}

// 级别多值：一个竞赛常有 校赛→省赛→国赛 链路
model CompetitionLevel {
  competitionId String
  level         Level

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, level])
  @@index([level])
}

// 时间节点（日历数据源）
model CompetitionTimeline {
  id            String    @id @default(cuid())
  competitionId String
  stage         String
  level         Level?
  startAt       DateTime?
  endAt         DateTime?

  isAuto   Boolean @default(false)
  isLocked Boolean @default(false)

  competition Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  revisions   CrawlRevision[]

  @@index([startAt])
  @@index([endAt])
  @@index([competitionId])
}

model CompetitionTag {
  competitionId String
  tag           String

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, tag])
  @@index([tag])
}

model CompetitionAward {
  id            String  @id @default(cuid())
  competitionId String
  year          Int?
  awardName     String?
  teamName      String?
  members       String[]
  sourceUrl     String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
}

model CompetitionMaterial {
  id            String       @id @default(cuid())
  competitionId String
  kind          MaterialKind
  title         String
  url           String
  authorId      String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  author      User?       @relation(fields: [authorId], references: [id])

  @@index([competitionId])
  @@index([kind])
}

// ================= 采集子系统（结构预留：流水线本次不实现） =================

model CrawlSource {
  id            String       @id @default(cuid())
  name          String
  url           String
  kind          SourceKind
  cron          String
  parseStrategy ParseStrategy
  selectorConf  Json
  enabled       Boolean      @default(true)

  lastRunAt        DateTime?
  consecutiveFails Int       @default(0)
  health           SourceHealth @default(HEALTHY)

  snapshots CrawlSnapshot[]
  items     CrawlItem[]
  anomalies CrawlAnomaly[]
}

model CrawlSnapshot {
  id          String   @id @default(cuid())
  sourceId    String
  contentHash String
  fetchedAt   DateTime @default(now())

  source CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, fetchedAt])
}

model CrawlItem {
  id        String   @id @default(cuid())
  sourceId  String
  title     String
  link      String
  rawText   String?  @db.Text
  fetchedAt DateTime @default(now())
  processed Boolean  @default(false)

  source CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, processed])
}

// 版本记录：CRAWL 预留 / MANUAL 人工修改 / ROLLBACK 回滚动作，供 /admin/revisions 回滚
model CrawlRevision {
  id            String   @id @default(cuid())
  competitionId String?
  timelineId    String?
  field         String
  oldValue      String?  @db.Text
  newValue      String?  @db.Text
  origin        RevisionOrigin
  createdAt     DateTime @default(now())

  competition Competition?        @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  timeline    CompetitionTimeline? @relation(fields: [timelineId], references: [id], onDelete: SetNull)

  @@index([competitionId, createdAt])
  @@index([timelineId, createdAt])
}

model CrawlAnomaly {
  id            String   @id @default(cuid())
  sourceId      String?
  competitionId String?
  rule          String
  payload       Json
  detectedAt    DateTime @default(now())
  alerted       Boolean  @default(false)

  source      CrawlSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@index([detectedAt])
}

model CorrectionReport {
  id            String  @id @default(cuid())
  competitionId String
  field         String
  currentValue  String?
  proposedValue String?
  note          String? @db.Text
  reporterId    String
  status        CorrectionStatus @default(PENDING)
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  reporter    User        @relation(fields: [reporterId], references: [id])

  @@index([status, createdAt])
}

// ================= 队友匹配（广告牌模式） =================

// Team 即「招募帖」：队长发布，感兴趣的人通过公开的联系方式直接线下联系。
// 平台不做申请/审批；targetSize 与成员名单为队长手填的展示信息（成员不关联平台账号）。
// 帖子下方评论区由 Comment(targetType=TEAM) 承载。
model Team {
  id            String   @id @default(cuid())
  competitionId String
  leaderId      String
  goal          TeamGoal

  // 期望招募的方向标签（卡片展示 + 按方向筛选）；具体要求写在 requirement
  neededRoles RoleType[]
  requirement String?    @db.Text
  // 联系方式：QQ 与微信两个属性，至少填写一项（应用层校验），广告牌模式下直接公开展示
  qq          String?
  wechat      String?
  deadline    DateTime?
  // 计划招募人数（队长手填，展示用）
  targetSize  Int?

  status    TeamStatus @default(RECRUITING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id])
  leader      User        @relation("TeamLeader", fields: [leaderId], references: [id])
  members     TeamMember[]

  @@index([status, competitionId])
  @@index([deadline])
  @@index([leaderId])
}

// 已有成员情况：队长手填的纯展示名单（加入在平台外发生，不关联平台账号）。
// 已有成员数量 = 本表行数（派生，不落库）。
model TeamMember {
  id     String @id @default(cuid())
  teamId String

  grade   Int?
  college String?
  major   String?
  rank    String?
  intro   String?  @db.Text

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ================= 横向表 =================

// 经验库（P2，仅建表预留）
model Post {
  id       String       @id @default(cuid())
  authorId String
  title    String
  content  String       @db.Text
  kind     MaterialKind
  refined  Boolean      @default(false)
  likes    Int          @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  author   User      @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([kind, refined])
}

// 多态评论：COMPETITION / POST / TEAM（Q7，多态外键无原生支持，靠应用层维护）
model Comment {
  id         String       @id @default(cuid())
  authorId   String
  targetType CommentTarget
  targetId   String
  content    String       @db.Text
  // 楼中楼拍平：parentId 永远指向根评论；回复的回复用 replyToId 记录真实对象
  parentId   String?
  replyToId  String?
  // 点赞数（冗余计数，由 CommentLike 明细维护；排序友好）
  likes      Int          @default(0)
  createdAt  DateTime     @default(now())

  author User          @relation(fields: [authorId], references: [id])
  likedBy CommentLike[]

  @@index([targetType, targetId, createdAt])
}

// 评论点赞：联合主键天然防重复点赞
model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model Favorite {
  userId     String
  targetType CommentTarget
  targetId   String
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// 举报（P2 处理台，仅建表预留）
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String // TEAM / USER / COMMENT
  targetId   String
  reason     String   @db.Text
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([handled, createdAt])
}

// 发信日志（邮件留空，暂不写入）
model MailLog {
  id     String  @id @default(cuid())
  to     String
  kind   String
  status String
  error  String?
  sentAt DateTime @default(now())
}

// 封禁记录（管理后台用）
model BanRecord {
  id        String   @id @default(cuid())
  userId    String
  actorId   String
  reason    String?
  createdAt DateTime @default(now())

  user  User @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("BanActor", fields: [actorId], references: [id])
}

// 系统公告（管理后台发布，站内横幅展示）
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())

  @@index([active, createdAt])
}
