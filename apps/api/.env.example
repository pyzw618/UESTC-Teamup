# 复制为 apps/api/.env 后按实际环境修改；.env 已被 .gitignore 忽略，绝不提交
#
# 本机开发（Windows + WSL2 内的 PostgreSQL/Redis）注意：
# 主机必须写 127.0.0.1 而不是 localhost —— WSL 中 PG 只监听 IPv4，
# Node 会先解析 ::1，用 localhost 会报 Prisma P1001。

# 数据库
DATABASE_URL="postgresql://teamup:teamup_dev@127.0.0.1:5432/teamup?schema=public"

# Redis（验证码 / Session / 限流 / 锁）
REDIS_URL="redis://127.0.0.1:6379"

# 运行环境：development | production
NODE_ENV=development

# API 端口
PORT=3000

# 会话
SESSION_TTL_HOURS=168
COOKIE_SECRET=请改为随机生成的64位字符串

# 邮件：console = 验证码打印到后端控制台（开发默认）；qq = 真实 SMTP 发送
# 接入时填 QQ 邮箱 16 位 SMTP 授权码（非登录密码），并将 MAIL_PROVIDER 改为 qq
MAIL_PROVIDER=console
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_USER=
QQ_SMTP_PASS=

# 前端来源（CORS 白名单，多个用逗号分隔）
WEB_ORIGIN=http://localhost:5173
