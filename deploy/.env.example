# 生产环境变量示例 —— 复制为 .env 并填写，绝不提交到 git
POSTGRES_PASSWORD=change-me-strong-password
COOKIE_SECRET=change-me-random-64-chars

# 运行环境（生产必须为 production，否则邮件模块的生产守卫逻辑不生效）
NODE_ENV=production
# 真实对外域名（后端 CORS 白名单，逗号分隔；未设置会回退 localhost 导致跨域被拒）
WEB_ORIGIN=https://teamup.20050917.xyz
# 前置层已启用 HTTPS 时设为 true（详见 docs/DEPLOY_INGRESS.md；否则浏览器拒收 Secure cookie）
COOKIE_SECURE=true

# 邮件：生产必须用 qq 并填写 16 位 SMTP 授权码；console 在生产会被后端拒绝启动
# （console 模式下验证码只进日志，日志读取权限等同任意账号登录权限）
MAIL_PROVIDER=qq
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_USER=
QQ_SMTP_PASS=
# 发件人显示名 / 全局每日发信上限（保护 QQ 邮箱额度，按实际额度调整）
MAIL_FROM_NAME=UESTC TeamUp
MAIL_GLOBAL_DAILY_LIMIT=200
